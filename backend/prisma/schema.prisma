// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String?
  birthDate     DateTime?
  birthTime     String?
  createdAt     DateTime  @default(now())
  vipTier       String    @default("FREE") // FREE, VIP, SORCERER
  vipExpiresAt  DateTime?
  partner       Partner?
  breakups      Breakup[]
  chatMessages  ChatMessage[]
  tarotReadings TarotReading[]
  subscriptions Subscription[]
  usageStats    UsageStats?
}

model Partner {
  id            String   @id @default(uuid())
  userId        String   @unique
  name          String
  birthDate     DateTime
  birthTime     String
  birthPlace    String
  relationship  String
  startDate     DateTime
  user          User     @relation(fields: [userId], references: [id])
}

model Breakup {
  id              String    @id @default(uuid())
  userId          String
  partnerName     String
  breakupDate     DateTime
  autoDeleteDate  DateTime
  weeklyCheckDone String
  user            User      @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  content   String
  role      String
  type      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model TarotReading {
  id            String   @id @default(uuid())
  userId        String
  question      String
  cardsDrawn    String
  interpretation String
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
}

model Subscription {
  id            String   @id @default(uuid())
  userId        String
  tier          String   // FREE, VIP, SORCERER
  price         Int
  startDate     DateTime @default(now())
  endDate       DateTime
  status        String   @default("active") // active, expired, cancelled
  paymentMethod String?
  transactionId String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
}

model UsageStats {
  id                  String   @id @default(uuid())
  userId              String   @unique
  tarotReadingsToday  Int      @default(0)
  chatMessagesToday   Int      @default(0)
  astrologyToday      Int      @default(0)
  fortuneToday        Int      @default(0)
  numerologyToday     Int      @default(0)
  lastResetDate       DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id])
}
